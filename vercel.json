{
  "version": 2,
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_AUTHOR_LOGIN\" = \"github-actions[bot]\" ] || [ \"$VERCEL_GIT_COMMIT_AUTHOR_LOGIN\" = \"dependabot[bot]\" ]; then exit 0; else exit 1; fi",
  "regions": [
    "iad1"
  ],
  "framework": "nextjs",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/.next",
  "installCommand": "cd frontend && npm ci",
  "devCommand": "cd frontend && npm run dev",
  "env": {
    "NEXT_PUBLIC_TG_API_BASE": "@next_public_tg_api_base",
    "NEXT_PUBLIC_STRIPE_PRICE_PRO": "@next_public_stripe_price_pro",
    "NEXT_PUBLIC_STRIPE_PRICE_ENTERPRISE": "@next_public_stripe_price_enterprise"
  }
}
