# TokenGoblin Environment Configuration
# Copy this file to .env and configure for your environment.

# ═══════════════════════════════════════════════════════════
# ENVIRONMENT & RUNTIME
# ═══════════════════════════════════════════════════════════
# [OPTIONAL] Set to "production" for production deployments.
# When TG_ENV=production, demo tenant mode (header-only x-tenant-id) is strictly
# disabled and all API requests require bearer API key authentication.
TG_ENV=development

# [OPTIONAL] Server listen port (default: 8080) or full address via TG_ADDR (e.g. :8080)
PORT=8080
# TG_ADDR=":8080"

# [OPTIONAL] Set to true only if behind a trusted reverse proxy that rewrites headers
TG_TRUST_PROXY=false

# ═══════════════════════════════════════════════════════════
# DATABASE & CACHE
# ═══════════════════════════════════════════════════════════
# [OPTIONAL] PostgreSQL DSN. If set, Postgres is used as primary store.
# TG_DB_DSN="postgres://user:password@localhost:5432/tokengoblin?sslmode=disable"

# [OPTIONAL] SQLite database path (used when TG_DB_DSN is not set). Defaults to ./data/tokengoblin.sqlite
TG_DB_PATH="./data/tokengoblin.sqlite"

# [OPTIONAL] Redis address for distributed rate limiting & distributed pricing cache
# TG_REDIS_ADDR="127.0.0.1:6379"

# [OPTIONAL] Directory sink for background JSONL data-lake streaming
# TG_DATALAKE_DIR="./data/datalake"

# ═══════════════════════════════════════════════════════════
# BILLING & STRIPE (Required for live SaaS billing)
# ═══════════════════════════════════════════════════════════
# Stripe secret API key (sk_test_... for staging/dev, sk_live_... for production)
STRIPE_SECRET_KEY=sk_test_...

# Stripe endpoint signing secret for raw webhook verification (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe recurring subscription price IDs (generate with scripts/setup_stripe_prices.py)
STRIPE_PRICE_PRO=price_1Thf1HC651G6xmqGtSCnlYIF
STRIPE_PRICE_ENTERPRISE=price_1Thf1IC651G6xmqGbiiVjlTy

# [REQUIRED] Shared secret between Next.js frontend proxy and Go backend for verified webhook delivery
# Generate via: openssl rand -hex 32
TG_INTERNAL_WEBHOOK_SECRET=replace_with_a_secure_random_32_byte_hex_string

# ═══════════════════════════════════════════════════════════
# LEAD CAPTURE & CONTACT (Optional)
# ═══════════════════════════════════════════════════════════
# Upstream webhook URL for routing audit inquiries and lead forms
TG_CONTACT_WEBHOOK_URL=https://example.com/contact-hook
TG_CONTACT_WEBHOOK_SECRET=replace-with-a-long-random-secret

# ═══════════════════════════════════════════════════════════
# FRONTEND CONFIGURATION (frontend/.env)
# ═══════════════════════════════════════════════════════════
NEXT_PUBLIC_TG_API_BASE=http://localhost:8080
NEXT_PUBLIC_STRIPE_PRICE_PRO=price_1Thf1HC651G6xmqGtSCnlYIF
NEXT_PUBLIC_STRIPE_PRICE_ENTERPRISE=price_1Thf1IC651G6xmqGbiiVjlTy
