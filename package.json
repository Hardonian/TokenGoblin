{
  "name": "tokengoblin",
  "version": "0.1.0",
  "private": true,
  "description": "Token usage ingestion and deterministic AI spend observability MVP.",
  "scripts": {
    "dev": "go run ./cmd/server",
    "build": "go build -o ./build/tokengoblin-server ./cmd/server",
    "start": "go run ./cmd/server",
    "lint": "go vet ./...",
    "typecheck": "go test ./... -run TestCompileOnly",
    "test": "go test ./...",
    "db:seed": "go run ./cmd/seed-demo",
    "smoke": "go run ./cmd/smoke"
  },
  "overrides": {
    "js-yaml": ">=4.3.0",
    "brace-expansion@^1": "1.1.21",
    "brace-expansion@^2": "2.1.7",
    "brace-expansion@^5": "5.0.12"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
